{
  "type": "object",
  "properties": {
    "summary": {"type": "string"},
    "claim_reviews": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {"type": "string"},
          "result": {"type": "string", "enum": ["confirmed", "disputed", "unverified"]},
          "note": {"type": "string"}
        },
        "required": ["id", "result", "note"],
        "additionalProperties": false
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {"type": "string"},
          "severity": {"type": "string", "enum": ["blocking", "advisory"]},
          "file": {"type": "string"},
          "start_line": {"type": "integer", "minimum": 0},
          "end_line": {"type": "integer", "minimum": 0},
          "description": {"type": "string"},
          "suggestion": {"type": "string"}
        },
        "required": ["id", "severity", "file", "start_line", "end_line", "description", "suggestion"],
        "additionalProperties": false
      }
    }
  },
  "required": ["summary", "claim_reviews", "findings"],
  "additionalProperties": false
}
